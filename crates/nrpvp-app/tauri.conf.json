{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightreign PvP",
  "version": "0.1.0",
  "identifier": "io.github.notgonnaleo.nightreignpvp",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nightclash",
        "width": 1120,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#090A0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
